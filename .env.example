# Copy to .env and fill in. Never commit .env.
# One of these. ANTHROPIC_API_KEY wins if both are set.
ANTHROPIC_API_KEY=
# Local dev via OpenRouter (Anthropic-compatible endpoint).
OPENROUTER_API_KEY=
# Model ids. Defaults: claude-haiku-5-5 / claude-sonnet-5-5, or anthropic/claude-haiku-5.5 /
# anthropic/claude-sonnet-5.5 with OpenRouter. Override if your provider names them differently.
# AGENT_MODEL=
# FEEDBACK_MODEL=
# Optional: Postgres for persistence. Unset = in-memory only.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tanda
# 1 = no API calls; agents act randomly (for local dev and load tests)
FAKE_LLM=1
# Cost hedge: agents generated per new room (max 1000). Existing rooms keep their audience.
AGENT_COUNT=100
# Rooms running rounds at once (others are queued), and rooms kept in total
MAX_ACTIVE_ROOMS=3
MAX_ROOMS=20
# 0 = do not create the demo room (Australia's under-16 social media ban, id au-u16-ban) on boot
DEFAULT_ROOM=1
CONCURRENCY=1000
ROUND_MS=15000
DAILY_REQUEST_CAP=200000
# Parallel Sonnet feedback requests (posts that finalize together must be ready for the reveal)
FEEDBACK_CONCURRENCY=30
# At most one "refetch" push to the room per this many ms
REFRESH_MS=1000
ADMIN_TOKEN=change-me
PORT=3000
